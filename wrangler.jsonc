{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers Builds — use a SEPARATE build step that runs OpenNext (not plain `next build`):
	//   Install: pnpm install --frozen-lockfile
	//   Build:   pnpm run cf:build
	//   Deploy:  pnpm exec wrangler deploy   OR   pnpm run deploy
	// (`pnpm run build` is only `next build` and does NOT emit .open-next / compiled open-next config.)
	// If the Git repo root is above this app, set the Worker project root directory to `menu-platform`.
	"main": ".open-next/worker.js",
	"name": "menu-platform",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
