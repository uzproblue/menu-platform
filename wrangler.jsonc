{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers Builds:
	//   Install: pnpm install --frozen-lockfile
	//   Build:   pnpm run build   (OpenNext — emits `.open-next/`; plain `next build` is `pnpm run build:next`)
	//   Deploy:  pnpm exec wrangler deploy   OR   pnpm run deploy
	// If the Git repo root is above this app, set the Worker project root directory to `menu-platform`.
	// Build must set R2_PUBLIC_BASE_URL or NEXT_PUBLIC_R2_PUBLIC_BASE_URL for the *build* step (dashboard:
	// Workers Builds → build env / variables). Worker *runtime* vars are not enough — next/image loader inlines CDN base at compile time.
	"main": ".open-next/worker.js",
	"name": "menu-platform",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Wrangler syncs this file on deploy. Without keep_vars, dashboard vars not listed in vars are removed.
	"keep_vars": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "MENU_SERVER",
			"service": "menu-server"
		},
		{
			"binding": "MENU_LOYALTY",
			"service": "menu-loyalty-worker"
		}
	],
	// Auth: set in dashboard or `wrangler secret put` / vars — do not use localhost in production:
	//   AUTH_SECRET, AUTH_TRUST_HOST=true, and optionally NEXTAUTH_URL=https://your-domain.com
	// Guest menu QR links: MENU_URL (and NEXT_PUBLIC_MENU_URL at build) — menu-customer origin, no trailing slash
	// "vars": { "AUTH_TRUST_HOST": "true" }
}
